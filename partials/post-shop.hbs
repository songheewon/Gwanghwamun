<div class="py-6">
  <div class="container mx-auto">
    <div class="mb-4 font-anton text-2xl font-black">{{@site.shop_section_title}}</div>
    <div class="shop-carousel relative px-0 sm:px-2 lg:px-5">
      <div class="shop-swiper overflow-hidden lg:-m-5 lg:p-5">
        <!-- Additional required wrapper -->
        <div class="swiper-wrapper">
          {{#get "products" limit=@custom.shop_posts_per_page order="published_at desc"}}
          {{#foreach products}}
          <div class="swiper-slide">
            <article class="c-home-product-card relative flex flex-col bg-white rounded-lg overflow-hidden shadow-sm gap-0">
              <!-- Image Section (60%) -->
              <div class="relative overflow-hidden">
                <a href="{{url}}" class="block w-full" style="aspect-ratio: 280 / 165;">
                  {{#if feature_image}}
                  <img
                    class="object-cover w-full h-full"
                    src="{{img_url feature_image}}"
                    alt="{{#if feature_image_alt}}{{ feature_image_alt }}{{ else }}{{ title }}{{/if}}"
                  >
                  {{else}}
                  <img
                    class="object-cover w-full h-full"
                    src="{{asset "img/layout/_default_01.png"}}"
                    alt="{{ title }}"
                  >
                  {{/if}}
                </a>
                <!-- Tags on top-left of image -->
                <div class="absolute top-2 left-2 flex gap-2 z-10">
                  {{#if published_at}}
                  <div class="new-badge text-3xs font-bold py-1 px-2 bg-[#17B2FF] text-white rounded" data-published="{{published_at}}" style="display: none;">NEW</div>
                  {{/if}}
                  <div class="text-3xs font-bold py-1 px-2 bg-black text-white rounded">
                    {{#match option_type "=" "etc"}}
                    기타
                    {{else match option_type "=" "webinar"}}
                    웨비나
                    {{else match option_type "=" "online-class"}}
                    온라인 강좌
                    {{else match option_type "=" "digital-book"}}
                    디지털북
                    {{else}}
                    기타
                    {{/match}}
                  </div>
                </div>
              </div>
              
              <!-- Content Section (40%) -->
              <div class="flex flex-col px-3 py-3 md:px-4 md:py-4 bg-white">
                <div class="flex-shrink-0">
                  <!-- Title -->
                  <h1 class="text-base font-bold mb-2 leading-tight min-h-[2.5rem]">
                    <a class="hover:underline block" href="{{url}}" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ title }}</a>
                  </h1>
                  
                  <!-- Price Section -->
                  <div class="mb-3">
                    {{#if @member.paid}}
                      <div class="text-xs text-gray-600 mb-1">유료회원할인가</div>
                      <div class="flex items-baseline gap-1 md:gap-2">
                        {{#match option_value.price_sale "=" null}}
                          <div class="text-3xs md:text-2xs font-bold py-0.5 px-1.5 md:px-2 bg-[#045CF3] text-white rounded-[20px]">Free</div>
                          <span class="text-sm md:text-lg font-bold">무료</span>
                        {{else match option_value.price_sale "=" 0}}
                          <div class="text-3xs md:text-2xs font-bold py-0.5 px-1.5 md:px-2 bg-[#045CF3] text-white rounded-[20px]">100% Off</div>
                          <span class="text-sm md:text-lg font-bold">무료</span>
                        {{else}}
                          {{#if option_value.price_original}}
                            <div class="discount-badge text-3xs md:text-2xs font-bold py-0.5 px-1.5 md:px-2 bg-[#FB7878] text-white rounded-[20px] whitespace-nowrap" data-original="{{price option_value.price_original currency="KRW" currencyFormat="none"}}" data-sale="{{price option_value.price_sale currency="KRW" currencyFormat="none"}}">할인</div>
                          {{/if}}
                          <span class="text-sm md:text-lg font-bold whitespace-nowrap">{{price option_value.price_sale currency="KRW" currencyFormat="none"}}원</span>
                          {{#if option_value.price_original}}
                            <span class="text-2xs md:text-xs text-gray-400 line-through whitespace-nowrap">{{price option_value.price_original currency="KRW" currencyFormat="none"}}원</span>
                          {{/if}}
                        {{/match}}
                      </div>
                    {{else}}
                      <div class="text-xs text-gray-600 mb-1">유료회원할인가</div>
                      <div class="flex items-baseline gap-1 md:gap-2">
                        {{#match option_value.price_sale "=" null}}
                          <div class="text-3xs md:text-2xs font-bold py-0.5 px-1.5 md:px-2 bg-[#045CF3] text-white rounded-[20px]">Free</div>
                          <span class="text-sm md:text-lg font-bold">무료</span>
                        {{else match option_value.price_sale "=" 0}}
                          <div class="text-3xs md:text-2xs font-bold py-0.5 px-1.5 md:px-2 bg-[#045CF3] text-white rounded-[20px]">100% Off</div>
                          <span class="text-sm md:text-lg font-bold">무료</span>
                        {{else}}
                          {{#if option_value.price_original}}
                            <div class="discount-badge text-3xs md:text-2xs font-bold py-0.5 px-1.5 md:px-2 bg-[#FB7878] text-white rounded-[20px] whitespace-nowrap" data-original="{{price option_value.price_original currency="KRW" currencyFormat="none"}}" data-sale="{{price option_value.price_sale currency="KRW" currencyFormat="none"}}">할인</div>
                          {{/if}}
                          <span class="text-sm md:text-lg font-bold whitespace-nowrap text-black">{{price option_value.price_sale currency="KRW" currencyFormat="none"}}원</span>
                          {{#if option_value.price_original}}
                            <span class="text-2xs md:text-xs text-gray-400 line-through whitespace-nowrap">{{price option_value.price_original currency="KRW" currencyFormat="none"}}원</span>
                          {{/if}}
                        {{/match}}
                      </div>
                    {{/if}}
                  </div>
                </div>
                
                <!-- Buy Button -->
                <a href="{{url}}" class="w-full text-white text-xs md:text-sm font-bold py-2 md:py-3 px-3 md:px-4 rounded text-center bg-[#045CF3] transition-colors flex-shrink-0">
                  지금 구매하기
                </a>
              </div>
            </article>
          </div>
          {{/foreach}}
          {{/get}}
          <!-- Slides -->
        </div>
      </div>

      <!-- If we need pagination -->
      <div class="swiper-pagination"></div>

      <!-- If we need navigation buttons -->
      <div class="swiper-button-prev text-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-10 mr-[3px]"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
      </div>
      <div class="swiper-button-next text-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-10 ml-[3px]"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
      </div>

    </div>
  </div>
</div>
<script>
(function() {
  // 할인율 계산 및 표시
  function calculateDiscount() {
    const discountBadges = document.querySelectorAll('.discount-badge');
    discountBadges.forEach(function(badge) {
      const original = parseFloat(badge.getAttribute('data-original'));
      const sale = parseFloat(badge.getAttribute('data-sale'));
      
      if (original && sale && original > sale) {
        const discountRate = Math.round(((original - sale) / original) * 100);
        badge.textContent = discountRate + '% Off';
      }
    });
  }
  
  // NEW 뱃지 표시 (최근 7일 내 게시물)
  function showNewBadges() {
    const newBadges = document.querySelectorAll('.new-badge');
    const now = new Date();
    const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
    
    newBadges.forEach(function(badge) {
      const publishedStr = badge.getAttribute('data-published');
      if (publishedStr) {
        const publishedDate = new Date(publishedStr);
        if (publishedDate >= sevenDaysAgo) {
          badge.style.display = 'block';
        }
      }
    });
  }
  
  // DOM이 로드된 후 실행
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      calculateDiscount();
      showNewBadges();
    });
  } else {
    calculateDiscount();
    showNewBadges();
  }
})();
</script>
