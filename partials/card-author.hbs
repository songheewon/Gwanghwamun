<section class='w-full flex p-8 rounded bg-[var(--background-secondary)] mt-[50px]'>
  {{#if profile_image}}
    <div class='w-20 h-20 rounded-full mr-6 bg-[var(--background-primary)]'>
      <a href='{{ url }}'>
        <img class='object-cover w-20 h-20 min-w-[80px] rounded-full' src='{{ img_url profile_image size='profile-image' }}' alt='{{ name }}' width='80' height='80'>
      </a>
    </div>
  {{/if}}

  <div class='flex-1'>
    <div class='flex items-center gap-2'>
      <a href='{{ url }}' class='text-[16px] font-[700] leading-7 font-bold hover:text-[var(--color-brand)] focus:text-[var(--color-brand)] active:text-[var(--color-brand)]'>{{ name }}</a>
      {{#if twitter}}
        <a href='{{ twitter_url }}' aria-label='Twitter' target='_blank' rel='noopener' class='inline-flex items-center hover:[&_.icon__cnt]:fill-[var(--color-brand)] focus:[&_.icon__cnt]:fill-[var(--color-brand)] active:[&_.icon__cnt]:fill-[var(--color-brand)]'>
          <div class="icon icon--ei-sc-twitter icon--s w-6 h-6">
            <svg class="icon__cnt fill-[var(--color-text-primary)] w-6 h-6"><use xlink:href="#ei-sc-twitter-icon"><svg id="ei-sc-twitter-icon" viewBox="0 0 50 50"><path d="M39.2 16.8c-1.1.5-2.2.8-3.5 1 1.2-.8 2.2-1.9 2.7-3.3-1.2.7-2.5 1.2-3.8 1.5-1.1-1.2-2.7-1.9-4.4-1.9-3.3 0-6.1 2.7-6.1 6.1 0 .5.1.9.2 1.4-5-.2-9.5-2.7-12.5-6.3-.5.7-.8 1.7-.8 2.8 0 2.1 1.1 4 2.7 5-1 0-1.9-.3-2.7-.8v.1c0 2.9 2.1 5.4 4.9 5.9-.5.1-1 .2-1.6.2-.4 0-.8 0-1.1-.1.8 2.4 3 4.2 5.7 4.2-2.1 1.6-4.7 2.6-7.5 2.6-.5 0-1 0-1.4-.1 2.4 1.9 5.6 2.9 9 2.9 11.1 0 17.2-9.2 17.2-17.2V20c1.2-.9 2.2-1.9 3-3.2z"></path></svg></use></svg>
          </div>
        </a>
      {{/if}}
      {{#if facebook}}
        <a href='{{ facebook_url }}' aria-label='Facebook' target='_blank' rel='noopener' class='inline-flex items-center hover:[&_.icon__cnt]:fill-[var(--color-brand)] focus:[&_.icon__cnt]:fill-[var(--color-brand)] active:[&_.icon__cnt]:fill-[var(--color-brand)]'>
          <div class="icon icon--ei-sc-facebook icon--s w-6 h-6">
            <svg class="icon__cnt fill-[var(--color-text-primary)] w-6 h-6"><use xlink:href="#ei-sc-facebook-icon"><svg id="ei-sc-facebook-icon" viewBox="0 0 50 50"><path d="M26 20v-3c0-1.3.3-2 2.4-2H31v-5h-4c-5 0-7 3.3-7 7v3h-4v5h4v15h6V25h4.4l.6-5h-5z"></path></svg></use></svg>
          </div>
        </a>
      {{/if}}
    </div>

    {{#if bio}}
      <div class='[&_p]:!text-[14px] [&_p]:!leading-6 [&_p]:!break-words [&_p]:!font-[300]'>{{ markdown bio }}</div>
    {{/if}}
  </div>
</section>