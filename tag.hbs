{{!< default}}

{{#tag}}
<div class="container mx-auto py-[20px] pt-[30px] max-w-[940px]">
  <div class="tag-header">
    <div class="tag-name font-bold text-[2rem] mb-6">{{name}}</div>
  </div>
</div>
{{/tag}}

<div class="lg:container lg:mx-auto lg:max-w-[940px]">
  <div class="divider border-b border-b-black/20 lg:border-b-gray-e0"></div>
</div>

<div class="posts">
  <div class="container mx-auto max-w-[940px]">
    <div class="posts-wrapper flex flex-col py-10 md:py-10 lg:py-4">
  {{#foreach posts}}
      <article class="post-article py-6 flex gap-x-10 bg-white border-b border-black/10 md:py-8">

        <div class="content grow flex flex-col">
          <h1 class="text-lsm font-bold line-clamp-3 grow leading-snug break-all hover:underline md:text-lg mb-2"><a class="leading-snug inline-block" href="{{ url }}">{{ title }}</a></h1>
          <div class="hidden grow md:block">
            <p class="text-sm break-all leading-normal mb-5 line-clamp-2 lg:line-clamp-3">{{ excerpt }}</p>
          </div>
          <div class="flex items-center text-xs font-bold gap-x-4 md:gap-x-6">
            {{#primary_tag}}
            <div class="primary-tag text-core-tag">
              <a href="{{url}}">{{name}}</a>
            </div>
            {{/primary_tag}}
            {{#primary_author}}
            <div class="flex items-center gap-x-1">
              <div class="text-gray-b9 text-sm font-medium font-tinos">by</div>
              <div class="author">
                  <a href="{{url}}">{{name}}</a>
              </div>
            </div>
            {{/primary_author}}
            <div class="hidden text-gray-b9 font-medium xl:block">{{date published_at format="YYYY년 M월 D일"}}</div>
          </div>
        </div>

        <div class="featured-image relative">
          <div class="absolute right-0 top-0">
            {{> visibility }}
          </div>
          <div class="aspect-post w-30 bg-gray-e5 md:w-[180px]">
            <a href="{{ url }}" class="flex h-full items-center justify-center">

              {{#if feature_image}}
              <img
                class="object-cover w-full h-full border border-gray-e6"
                src="{{img_url feature_image}}"
                alt="{{#if feature_image_alt}}{{ feature_image_alt }}{{ else }}{{ title }}{{/if}}"
              >
              {{else}}
              <img
                    class="object-cover w-full h-full border border-gray-e6"
                    src="{{asset "img/layout/_default_01.png"}}"
                    alt="{{ title }}"
                  >
              {{/if}}
            </a>
          </div>
        </div>

      </article>
  {{/foreach}}
    </div>
  </div>
</div>

<div class="container mx-auto py-20">
  <div class="flex items-center justify-center">
    <button class="hidden bg-black text-white w-[300px] h-[60px] rounded-full items-center justify-center js-load-posts disabled:opacity-50 disabled:cursor-not-allowed">{{t 'More Posts' }}</button>
  </div>
</div>
